{
    "name": "squeak/rat",
    "description": "squeak/rat — squeak-rat: Laravel Application Security & Behavior Analyzer. Terminal forensic tool for Laravel. 🐀 RAT follows the trail.",
    "type": "library",
    "keywords": ["laravel", "security", "static-analysis", "taint-analysis", "terminal", "forensic"],
    "license": "MIT",
    "authors": [
        {
            "name": "RAT",
            "role": "Laravel Security & Behavior Analyzer"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "symfony/console": "^5.4|^6.0|^7.0|^8.0",
        "nikic/php-parser": "^4.0|^5.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "suggest": {
        "ext-gd": "For true-color rat.png rendering in terminal (fallback to block letters if missing)",
        "ext-posix": "For TTY detection (vendor exclusion always works without it)",
        "ext-imagick": "Alternative image handling"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Rat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rat\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rat\\RatServiceProvider"
            ]
        }
    },
    "bin": ["bin/rat"],
    "scripts": {
        "post-autoload-dump": [
            "@php -r \"file_exists('bin/rat') && chmod('bin/rat', 0755);\""
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
